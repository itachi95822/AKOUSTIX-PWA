# Copy to .env and fill in. The publishable (anon) key is client-safe — it is
# protected by Row Level Security, NOT by secrecy. Never put the service role
# key (sb_secret_...) in client code or in this file.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
